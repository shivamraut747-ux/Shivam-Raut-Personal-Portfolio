# ==============================================================================
# SECURE CONTACT FORM ENVIRONMENT CONFIGURATION (.env)
# ==============================================================================
# IMPORTANT: Copy this file to .env and replace placeholder values with your real keys.
# NEVER commit your actual .env file with real credentials to GitHub!
# ==============================================================================

# Server Network Configuration
PORT=3001
NODE_ENV=production

# Frontend Origin for CORS Protection
# Allow requests only from your domain (comma-separated if multiple)
CLIENT_ORIGIN=https://shivamraut.me

# ------------------------------------------------------------------------------
# 1. Google reCAPTCHA v3 Configuration
# Register your domain at: https://www.google.com/recaptcha/admin
# ------------------------------------------------------------------------------
# Public Site Key (safe to use in frontend HTML / JS)
VITE_RECAPTCHA_SITE_KEY=your_google_recaptcha_v3_site_key_here

# Private Secret Key (MUST be kept strictly confidential on server)
RECAPTCHA_SECRET_KEY=your_google_recaptcha_v3_secret_key_here

# Score threshold (0.0 to 1.0; 0.5+ recommended for human traffic)
RECAPTCHA_MIN_SCORE=0.5

# ------------------------------------------------------------------------------
# 2. Gmail SMTP Credentials (Nodemailer)
# Requires 2-Step Verification enabled on your Google Account.
# Generate App Password at: https://myaccount.google.com/apppasswords
# ------------------------------------------------------------------------------
# Your full Gmail address
EMAIL_USER=shivamraut747@gmail.com

# 16-character Google App Password (without spaces)
EMAIL_PASS=your_16_character_gmail_app_password

# Destination inbox where inquiries should be delivered (defaults to EMAIL_USER if omitted)
RECIPIENT_EMAIL=shivamraut747@gmail.com
