# ==============================================================================
# SECURITY-HARDENED .gitignore
# Prevents sensitive credentials, environment secrets, and build artifacts from leaking
# ==============================================================================

# Environment variable files (CRITICAL SECURITY)
.env
.env.*
.env.local
.env.development.local
.env.test.local
.env.production.local
.dev.vars
!*.example

# Private API keys and SSL certificates
*.pem
*.key
*.cert
*.crt
*.pfx
*.p12

# Node dependencies and package caches
node_modules/
.pnp
.pnp.js
.yarn/cache/

# Debug and runtime logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Production build outputs
dist/
dist-ssr/
build/
.output/
.vercel/
.nitro/
.cache/

# OS metadata
.DS_Store
Thumbs.db
desktop.ini

# IDE and Editor directories
.idea/
.vscode/*
!.vscode/extensions.json
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
