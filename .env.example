# ==============================================================================
# SECURE CONTACT FORM ENVIRONMENT CONFIGURATION (.env)
# ==============================================================================

# Server port
PORT=3001

# Environment (development | production)
NODE_ENV=production

# Frontend Origin for CORS (e.g. https://shivamraut.me)
CLIENT_ORIGIN=https://shivamraut.me

# ------------------------------------------------------------------------------
# 1. Google reCAPTCHA v3
# Obtain from https://www.google.com/recaptcha/admin
# ------------------------------------------------------------------------------
# Public Site Key (exposed to frontend)
VITE_RECAPTCHA_SITE_KEY=your_recaptcha_v3_site_key_here

# Secret Key (keep strictly private on server)
RECAPTCHA_SECRET_KEY=your_recaptcha_v3_secret_key_here

# Minimum score threshold to classify as human (default: 0.5)
RECAPTCHA_MIN_SCORE=0.5

# ------------------------------------------------------------------------------
# 2. Gmail Nodemailer SMTP (Requires 2FA + Gmail App Password)
# Obtain from https://myaccount.google.com/apppasswords
# ------------------------------------------------------------------------------
EMAIL_USER=shivamraut747@gmail.com
# 16-character App Password generated from Google Account (without spaces)
EMAIL_PASS=your_16_character_gmail_app_password

# Where you want to receive inquiries (defaults to EMAIL_USER if omitted)
RECIPIENT_EMAIL=shivamraut747@gmail.com
